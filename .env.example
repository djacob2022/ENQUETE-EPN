# Copier en .env puis adapter. Ne jamais versionner le fichier .env.

# --- Django ---
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=remplacer-par-une-longue-chaine-aleatoire
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
# Cookies transmis seulement en HTTPS. Mettre 0 uniquement pour un test sur poste en http://localhost.
COOKIES_SECURE=1
# Nombre de proxys de confiance devant l'application (1 derrière Nginx ou Traefik, 0 en accès direct).
NB_PROXYS_DE_CONFIANCE=0
# Adresse publique de l'application, utilisée dans les liens envoyés aux EPN.
SITE_URL=http://localhost:8000
NOM_INSTITUTION=[Nom de l'institution de tutelle]
# En-tête officiel affiché sur toutes les pages.
PAYS=République de [Pays]
DEVISE=[Devise nationale]
NOM_MINISTERE=[Ministère de tutelle]
TIME_ZONE=Africa/Abidjan

# --- Compte administrateur créé au premier démarrage ---
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=changer-ce-mot-de-passe
DJANGO_SUPERUSER_EMAIL=admin@example.org

# --- Base de données ---
POSTGRES_DB=enquete
POSTGRES_USER=enquete
POSTGRES_PASSWORD=changer-ce-mot-de-passe-aussi

# --- E-mails (par défaut : Mailpit, le serveur de test du docker-compose) ---
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_USE_TLS=0
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=ENQUETE-EPN <no-reply@enquete-epn.local>

# --- Base hébergée (facultatif, ex. Supabase : voir docs/CLOUDFLARE.md) ---
# postgresql://utilisateur:mot-de-passe@hôte:5432/postgres ; vide = conteneur PostgreSQL local (POSTGRES_* ci-dessus).
DATABASE_URL=

# --- Cloudflare Tunnel (facultatif, voir docs/CLOUDFLARE.md) ---
# Jeton du tunnel créé dans Cloudflare (Zero Trust > Networks > Tunnels). Vide = publication par Caddy.
CLOUDFLARE_TUNNEL_TOKEN=

# 1 = charger des EPN et réponses fictives au démarrage (démonstration sur poste uniquement, jamais en production).
CHARGER_DONNEES_DEMO=0
