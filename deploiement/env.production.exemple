# Configuration de PRODUCTION. Le script installer.sh crée .env à partir de ce modèle.
# Ne jamais versionner le fichier .env.

# --- Adresse du site ---
DOMAINE=enquete.mon-ministere.example
SITE_URL=https://enquete.mon-ministere.example
DJANGO_ALLOWED_HOSTS=enquete.mon-ministere.example
DJANGO_CSRF_TRUSTED_ORIGINS=https://enquete.mon-ministere.example
# Adresse prévenue par Let's Encrypt (expiration de certificat, incident).
EMAIL_ADMIN=informatique@mon-ministere.example

# --- Identité officielle (en-tête des pages) ---
PAYS=République de [Pays]
DEVISE=[Devise nationale]
NOM_MINISTERE=[Ministère de tutelle]
NOM_INSTITUTION=[Nom de l'institution de tutelle]
TIME_ZONE=Africa/Abidjan

# --- Sécurité (valeurs générées par installer.sh) ---
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=a-generer
COOKIES_SECURE=1
NB_PROXYS_DE_CONFIANCE=1

# --- Compte administrateur créé au premier démarrage ---
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=a-generer
DJANGO_SUPERUSER_EMAIL=informatique@mon-ministere.example

# --- Base de données ---
POSTGRES_DB=enquete
POSTGRES_USER=enquete
POSTGRES_PASSWORD=a-generer

# --- E-mails : serveur SMTP RÉEL (messagerie du ministère, Brevo, Mailjet, Amazon SES…) ---
EMAIL_HOST=smtp.mon-fournisseur.example
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Enquête EPN <enquete@mon-ministere.example>

# --- Jamais de données fictives en production ---
CHARGER_DONNEES_DEMO=0

# --- Rapport annuel automatique ---
# Envoyé par e-mail aux administrateurs N jours après la clôture de chaque campagne (vide = jamais).
RAPPORT_AUTO_JOURS=15

# --- Assistant IA (facultatif) : questions sur les résultats et synthèse du rapport annuel ---
# Clé à créer sur https://console.anthropic.com (compte de l'institution). Vide = assistant désactivé.
# Le serveur doit pouvoir joindre https://api.anthropic.com. Voir docs/ASSISTANT-IA.md.
ANTHROPIC_API_KEY=
ASSISTANT_IA_MODELE=claude-opus-5-5
ASSISTANT_IA_EFFORT=medium
ASSISTANT_IA_QUESTIONS_PAR_HEURE=30
